{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clearclause",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],

  // Static single-page app. `run_worker_first` is scoped to the API so asset
  // requests are served straight from the edge without invoking the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Inference. This is a binding, not an API key: there is no credential in
  // this repository, in CI, or in the deployed bundle.
  "ai": {
    "binding": "AI"
  },

  // Per-IP request cap. Analysis is the expensive path, so it is the one that
  // is limited; static assets are unaffected.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "upload_source_maps": true
}
