{
  "name": "clearclause",
  "version": "1.0.0",
  "description": "Plain-English analysis of contracts you are asked to sign, with every judgement grounded in the words of your own document.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.dom.json",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,css,html,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,css,html,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "audit": "npm audit --audit-level=high",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.3",
    "@vitest/coverage-istanbul": "^4.1.11",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "hono": "^4.13.7"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
